# Incoming Webhook — текст заявки (канал задаётся в webhook)
ROCKETCHAT_WEBHOOK_URL=

# REST API — чтобы приложить файл счёта в канал
# Personal Access Token пользователя/бота с доступом к каналу
ROCKETCHAT_URL=https://your-rocketchat.example.com
ROCKETCHAT_USER_ID=
ROCKETCHAT_AUTH_TOKEN=
# Имя канала без #  ИЛИ  room id
ROCKETCHAT_CHANNEL=
